# Discord Bot Token - Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Client ID
CLIENT_ID=your_client_id_here

# Channel ID where content watching is tracked (optional)
CONTENT_CHANNEL_ID=your_channel_id_here

# XP Configuration
XP_PER_MINUTE=10
XP_CHECK_INTERVAL=60000
